# =============================================
# VendorBridge - Complete .gitignore
# =============================================

# =============================================
# NODE MODULES
# =============================================
**/node_modules/
node_modules/

# =============================================
# ENVIRONMENT VARIABLES
# =============================================
**/.env
.env
.env.local
.env.*.local
**/.env.local
**/.env.*.local

# Keep example files
!.env.example
!**/.env.example

# =============================================
# BUILD OUTPUT
# =============================================
# Frontend (Vite)
frontend/dist/
frontend/build/
frontend/.vite/

# Backend
backend/dist/
backend/build/

# =============================================
# LOGS
# =============================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

logs/
*.log.*

# =============================================
# OPERATING SYSTEM FILES
# =============================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.directory
.Trash-*

# =============================================
# IDE / EDITOR
# =============================================
# VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains (WebStorm, IntelliJ, etc.)
.idea/
*.iml
*.iws
*.ipr
out/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~
.netrwhist

# Emacs
*~
\#*\#
.\#*

# =============================================
# DEPENDENCIES & PACKAGE MANAGERS
# =============================================
package-lock.json
yarn.lock
pnpm-lock.yaml

# Yarn
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*

# =============================================
# TESTING
# =============================================
coverage/
*.coverage
.nyc_output/
.jest/

# =============================================
# TYPESCRIPT
# =============================================
*.tsbuildinfo

# =============================================
# DATABASE
# =============================================
*.sqlite
*.sqlite3
*.db

# PostgreSQL backup files
*.sql.gz
*.dump

# =============================================
# UPLOADS & TEMP FILES
# =============================================
uploads/
tmp/
temp/
*.tmp

# =============================================
# CERTIFICATES & KEYS
# =============================================
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx

# =============================================
# MISC
# =============================================
.cache/
.parcel-cache/
.npm/
.eslintcache
.stylelintcache

# =============================================
# PROJECT SPECIFIC
# =============================================
# Backend specific
backend/.env
backend/uploads/
backend/logs/

# Frontend specific
frontend/.env
frontend/.env.local
frontend/.env.production.local
frontend/.env.development.local

# =============================================
# BACKUP FILES
# =============================================
*.bak
*.backup
*.old
*~

# =============================================
# COMPRESSED FILES (optional - uncomment if needed)
# =============================================
# *.zip
# *.tar
# *.tar.gz
# *.rar
# *.7z
